<?xml version="1.0" encoding="UTF-8" ?>
<taglib xmlns="http://java.sun.com/xml/ns/javaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-jsptaglibrary_2_1.xsd"
        version="2.1">
    
    <tlib-version>1.0</tlib-version>
    <short-name>fn</short-name>
    <uri>http://project.hcmuaf.edu.vn/functions</uri>
    
    <function>
        <name>formatPrice</name>
        <function-class>vn.edu.hcmuaf.fit.project_ltweb.utils.FormatUtil</function-class>
        <function-signature>java.lang.String formatPrice(double)</function-signature>
    </function>
    
    <function>
        <name>formatPriceCompact</name>
        <function-class>vn.edu.hcmuaf.fit.project_ltweb.utils.FormatUtil</function-class>
        <function-signature>java.lang.String formatPriceCompact(double)</function-signature>
    </function>
</taglib>
